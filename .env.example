POSTGRES_DB=questcity
POSTGRES_USER=questcity
POSTGRES_PASSWORD=questcity
DATABASE_URL=postgresql+asyncpg://questcity:questcity@postgres:5432/questcity
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
ALLOW_LOCATION_BYPASS=true
MEDIA_MAX_UPLOAD_MB=20
VITE_API_URL=http://localhost:8000/api/v1

# Quest generator — server-side only. Insert the real API key in .env.
LLM_API_KEY=
LLM_BASE_URL=https://ai.starimg.ru/v1
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=16000
